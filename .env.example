VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PROSPECTING_MOCK_MODE=true
VITE_ENABLE_DEMO_AUTH=false

# Build-time feature flags (set false to disable a route and its navigation link).
VITE_ENABLE_AI_SDR=true
VITE_ENABLE_INBOX=true
VITE_ENABLE_PROPOSALS=true
VITE_ENABLE_ADVANCED_ANALYTICS=true
VITE_ENABLE_AUTOMATED_CADENCES=true

# Configure these only as Supabase Edge Function secrets, never in VITE_* variables:
# GOOGLE_PLACES_API_KEY
# PAGESPEED_API_KEY (optional)
# OPENAI_API_KEY
# AI_LEAD_ANALYSIS_MODEL
# AI_OUTREACH_MODEL
# SUPABASE_SERVICE_ROLE_KEY (provided by Supabase to Edge Functions; never copy here)
